rules_version = '2';

// FitDesk: her kullanıcı yalnızca kendi verisini okuyup yazabilir.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/activity/{entryId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['exerciseId', 'at'])
        && request.resource.data.exerciseId is string
        && request.resource.data.at is timestamp;
    }

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
